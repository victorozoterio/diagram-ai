{
  "name": "diagram-ai",
  "version": "0.0.1",
  "description": "",
  "author": "Victor Ozoterio",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "prepare": "husky",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "dev:api": "pnpm --filter @diagram-ai/api start:dev",
